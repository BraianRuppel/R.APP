<?xml version="1.0" encoding="utf-8"?>
<resources>

    <string name="app_name">R.APP</string>

    <style name="Theme.Rapp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores principales del tema -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_light</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>

        <!-- Colores de fondo -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>

        <!-- Colores de texto -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Color de error -->
        <item name="colorError">@color/error</item>

        <!-- Aplicar estilo a TODOS los botones automáticamente -->
        <item name="materialButtonStyle">@style/AppButton</item>

        <!-- Aplicar estilo a TODOS los TextInputLayout automáticamente -->
        <item name="textInputStyle">@style/AppEditText</item>
    </style>

</resources>